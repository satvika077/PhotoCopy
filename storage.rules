rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /documents/{uid}/{file} { allow read, write: if request.auth != null && request.auth.uid == uid && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('application/(pdf)|image/(jpeg|png)'); }
    match /profile-images/{uid}/{file} { allow read: if request.auth != null; allow write: if request.auth != null && request.auth.uid == uid; }
  }
}
